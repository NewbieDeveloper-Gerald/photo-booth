{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "noEmit": false
  },
  "include": [
    "electron/**/*.ts",
    "src/storage/**/*.ts",
    "src/shared/**/*.ts",
    "src/features/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "tests/**"]
}
